rules_version = '2';

// Data isolation policy: every document a user can access lives under
// /users/{uid}/... and only that uid's authenticated owner may read/write it.
// There is no top-level collection that mixes multiple users' data together.
// These rules are defense-in-depth — every API route also independently
// verifies the Firebase ID token server-side before touching Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Rate-limit counters are written only by the trusted server (Admin SDK,
    // which bypasses these rules) — clients get no direct access at all.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
